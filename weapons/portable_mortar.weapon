<?xml version="1.0" encoding="utf-8"?>
<weapon key="portable_mortar.weapon">
    <tag name="mortar" />

    <specification retrigger_time="1.5" accuracy_factor="0.9" sight_range_modifier="1.5" sustained_fire_grow_step="1.0" sustained_fire_diminish_rate="0.1" magazine_size="1" can_shoot_standing="0" can_shoot_crouching="1" can_shoot_prone="0" suppressed="0" name="Portable Mortar" class="4" projectile_speed="100.0"  barrel_offset="0.6" spread_range="0.0001" />

    <ballistics near_far_distance="1.0" speed_estimation_near="20.0" speed_estimation_far="35.0" max_speed="100.0" randomness="0.07" />


	<animation state_key="reload" 			animation_key="reload, mortar" />
	<animation state_key="recoil" 			animation_key="recoil, mortar" />
	<animation state_key="hold" 				animation_key="still, mortar" />
	<animation state_key="crouching" 			animation_key="crouch still, mortar" />

    <sound key="fire" fileref="portable_mortar_shot.wav" pitch_variety="0.1" />
    <sound key="magazine_in" fileref="portable_mortar_reload.wav" />
    <sound key="cycle" fileref="rifle_chamber.wav" />

    <model filename="rpg-7.xml" />

    <projectile file="rocket2.projectile" />
    <weak_hand_hold offset="0.3" />

    <capacity value="1" source="rank" source_value="0.0" />

    <hud_icon filename="hud_portable_mortar.png" />
    <commonness value="0.2" />
    <inventory encumbrance="11.0" price="3.0" />

    <effect class="muzzle" ref="LawMuzzle" />
    <effect class="muzzle" ref="UpDust" />


    <stance state_key="running" accuracy="0.1" />
    <stance state_key="walking" accuracy="0.5" />
    <stance state_key="crouch_moving" accuracy="0.1" />
    <stance state_key="prone_moving" accuracy="0.1" />

    <stance state_key="standing" accuracy="1.0" />
    <stance state_key="crouching" accuracy="1.0" />
    <stance state_key="prone" accuracy="1.0" />

</weapon>
