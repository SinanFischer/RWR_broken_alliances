<?xml version="1.0" encoding="utf-8"?>
<!-- media/packages/RWR_broken_alliances/weapons/qjz89_volk.weapon -->
<weapon file="base_primary_rare.weapon" key="qjz89_volk.weapon">
    <tag name="machine gun" />
    <specification
    retrigger_time="0.15"
    accuracy_factor="0.83"
    sustained_fire_grow_step="0.8"
    sustained_fire_diminish_rate="0.12"
    spread_range="0.20"
    sight_range_modifier="1.2"
    magazine_size="100"
    can_shoot_standing="0"
    can_shoot_crouching="0"
    suppressed="0"
    name='QJZ-89 "Volk"'
    class="0"
    barrel_offset="0.65"
    projectile_speed="115.0"
    cooldown_start="2.0"
    cooldown_end="0.5"/>

    <animation key="recoil" ref="27" />
    <animation key="cycle" ref="30" />
    <animation key="hold_on_wall" ref="1" />

    <animation state_key="reload" animation_key="reloading, microgun" volume="0.95" />
    <animation state_key="running"            animation_key="walking, carrying load" />
    <animation state_key="walking"            animation_key="walking, carrying load" />
    <animation state_key="hold"               animation_key="still, carrying load" />
    <animation state_key="hold_casual"        animation_key="still, carrying load" />
    <animation state_key="still_against_wall" animation_key="still, carrying load" />
    <animation state_key="changing_weapon_in" animation_key="change weapon in, single hand carry" />

    <sound key="fire" fileref="qjz89_shot.wav" volume="0.4" pitch_variety="0.01"/>
    <sound key="magazine_out" fileref="mg_clip_out.wav" />
    <sound key="magazine_in" fileref="mg_clip_in.wav" />
    <sound key="cycle" fileref="rifle_chamber.wav" />
    <sound class="impact" fileref="rifle_drop.wav" />
    <model filename="qjz89.xml" />

    <sound key="cooldown" fileref="overheating_mg.wav" volume="0.5"/>

    <hud_icon filename="hud_qjz89.png" />
    <commonness value="0.005" can_respawn_with="1" in_stock="1" />
    <inventory encumbrance="10.0" price="180.0" />

    <weak_hand_hold offset="0.5" />
    <projectile file="50cal_bullet.projectile">
        <result class="hit" kill_probability="3.15" kill_decay_start_time="0.60" kill_decay_end_time="1.00" />
        <result class="blast" radius="0.5" damage="0.5" push="0.05" decal="0" />
        <!-- Größerer Aufschlag auf Boden (BigBurst + Rauch wie RPG) -->
        <effect class="result" key="terrain" ref="BigBurst" use_surface_color="1" />
        <effect class="result" key="terrain" ref="SmokeTop" post_processing="1" />
        <effect class="result" key="terrain" ref="LowDust" />
    </projectile>

    <!-- Prone-Spezialist: Läuft wie Blei, liegt wie eine Festung -->
    <stance state_key="running"      accuracy="0.10" />
    <stance state_key="walking"      accuracy="0.15" />
    <stance state_key="crouch_moving" accuracy="0.15" />
    <stance state_key="standing"     accuracy="0.75" />
    <stance state_key="crouching"    accuracy="0.80" />
    <stance state_key="prone"        accuracy="0.95" />
    <stance state_key="prone_moving" accuracy="0.30" />
    <stance state_key="over_wall"    accuracy="0.75" />

    <!-- Schwerer Muzzle: BigMuzzle + BiggerMuzzle + CannonSmoke für 12,7-mm-Visual -->
    <effect class="muzzle" ref="BigMuzzle" />
    <effect class="muzzle" ref="CannonSmokeBig" />

    <modifier class="speed" value="-0.55" />
</weapon>
