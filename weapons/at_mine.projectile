<?xml version="1.0" encoding="utf-8"?>
<projectile class="grenade" name="AT mine" key="at_mine.projectile" slot="0" on_ground_up="0 1 0" can_be_disarmed="1" >

    <result class="blast" radius="6.0" damage="400" decal="1" character_state="death" />
    <trigger class="impact"> 
     <collider class="terrain" enabled="0" /> 
     <collider class="static_object" enabled="1" /> 
     <collider class="vehicle" enabled="1" /> 
     <collider class="character" enabled="0" />
    </trigger>
    
    <rotation class="random" />

    <model mesh_filename="at_mine.mesh" texture_filename="at_mine.png" />
    <hud_icon filename="hud_at_mine.png" />

    <throwable curve_height="0.0" near_far_distance="0.0" speed_estimation_near="2.0" speed_estimation_far="2.0" max_speed="2.0" randomness="0.01" />

    <commonness value="0.0" />
	<capacity value="0" source="rank" source_value="0.0" />
    <capacity value="2" source="rank" source_value="0.2" />
    <capacity value="4" source="rank" source_value="0.3" />
    <capacity value="6" source="rank" source_value="0.6" />

    <sound class="result" key="other" fileref="explosion1.wav" />
    <sound class="result" key="other" fileref="explosion2.wav" />

    <sound class="result" key="terrain" copy="other" />
    <sound class="result" key="static_object" copy="other" />
    <sound class="result" key="vehicle" copy="other" />
    <sound class="result" key="character" copy="other" />

    <effect class="result" key="terrain" ref="BigBurst" use_surface_color="1" />
    <effect class="result" key="terrain" ref="SmokeTop" post_processing="1" />
    <effect class="result" key="terrain" ref="Smoke" post_processing="1" />
    <effect class="result" key="terrain" ref="Shine" lighting="0" />
    <effect class="result" key="terrain" ref="Godray" lighting="0" />
    <effect class="result" key="terrain" ref="ShadowSmoke" shadow="1" />
    <effect class="result" type="splat_map" surface_tag="" size="5.0" atlas_index="0" layer="1" />
    <effect class="result" type="splat_map" surface_tag="" size="6.5" atlas_index="4" layer="0" />
    <effect class="result" type="splat_map" surface_tag="" size="8.0" atlas_index="0" layer="2" additive="0" /> <!-- remove top snow everywhere -->

    <effect class="result" key="other" ref="SmokeTop" post_processing="1" />
    <effect class="result" key="other" ref="Smoke" post_processing="1" />
    <effect class="result" key="other" ref="Shine" lighting="0" />
    <effect class="result" key="other" ref="Godray" lighting="0" />
    <effect class="result" key="other" ref="ShadowSmoke" shadow="1" />

    <!-- heavy infantry Big Explosion effects -->

    <effect class="result" key="terrain" ref="xExpFog" />
    <effect class="result" key="terrain" ref="xExpRise" />
    <effect class="result" key="terrain" ref="xDirtExp" use_surface_color="1" />
    <effect class="result" key="terrain" ref="xExpSmoke" />
    <effect class="result" key="terrain" ref="xExpSmoke2" />
    <effect class="result" key="terrain" ref="xExpFlash" />
    <effect class="result" key="terrain" ref="xExpFlash2" />
    <effect class="result" key="terrain" ref="xShieldBurst2" />
    <effect class="result" key="terrain" ref="xgrenade" lighting="0" />
    <effect class="result" key="terrain" ref="xgrenade2" lighting="0" />
    <effect class="result" type="splat_map" surface_tag="" size="5.0" atlas_index="0" layer="1" />
    <effect class="result" type="splat_map" surface_tag="" size="6.5" atlas_index="4" layer="0" />
    <effect class="result" type="splat_map" surface_tag="" size="7.5" atlas_index="0" layer="2" additive="0" /> <!-- remove top snow everywhere -->

    <effect class="result" key="other" ref="xExpFog" />
    <effect class="result" key="other" ref="xExpRise" />
    <effect class="result" key="other" ref="xExpSmoke" />
    <effect class="result" key="other" ref="xExpSmoke2" />
    <effect class="result" key="other" ref="xExpFlash" />
    <effect class="result" key="other" ref="xExpFlash2" />
    <effect class="result" key="other" ref="xShieldBurst2" />
    <effect class="result" key="other" ref="xgrenade" lighting="0" />
    <effect class="result" key="other" ref="xgrenade2" lighting="0" />
<!-- End test -->



    <effect class="result" key="static_object" copy="terrain" />
    <effect class="result" key="vehicle" copy="terrain" />
    <effect class="result" key="character" copy="terrain" />

</projectile>
