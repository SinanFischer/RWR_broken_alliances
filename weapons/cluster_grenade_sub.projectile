<?xml version="1.0" encoding="utf-8"?>
<projectile class="grenade" name="cluster grenade sub" key="cluster_grenade_sub.projectile" slot="0" radius="0.45" pulldown_in_air="20.0">

    <trigger class="impact" />
	
	<result class="blast" radius="8.0" damage="0.99" push="0.3" decal="1" character_state="death" />

    <rotation class="random" />

    <throwable curve_height="6.5" near_far_distance="3.0" speed_estimation_near="8.0" speed_estimation_far="13.0" max_speed="12.0" randomness="0.20" />
    <model mesh_filename="" />
    <hud_icon filename="" />
    <!-- projectile slot 0 is used for hand grenade items currently -->
    <!-- bound to change -->
    <commonness value="0.0" can_respawn_with="0" in_stock="0"/>
    <capacity value="1" source="rank" source_value="0.0" />
    <capacity value="2" source="rank" source_value="0.2" />
    <capacity value="3" source="rank" source_value="0.4" />
    <inventory encumbrance="3.0" price="2.0" />

    <sound class="result" key="other" fileref="invalid.wav" />
    <sound class="result" key="terrain" copy="other" />
    <sound class="result" key="static_object" copy="other" />
    <sound class="result" key="vehicle" copy="other" />
    <sound class="result" key="character" copy="other" />
	<!-- remove top snow everywhere -->

