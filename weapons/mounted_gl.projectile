<?xml version="1.0" encoding="utf-8"?>
<projectile class="grenade" name="grenade" slot="1" pulldown_in_air="21.0" key="mounted_gl.projectile">
    <tag name="grenade"/>
    <result class="blast" radius="3.1" damage="0.60" decal="1" push="0.3" character_state="death" />
    <trigger class="impact" />
    <rotation class="motion" />
    <model mesh_filename="mgl_flasher_projectile.xml" />

    <commonness value="0.0" />

    <sound class="result" key="other" fileref="explosion5.wav" />

    <sound class="result" key="terrain" copy="other" />
    <sound class="result" key="static_object" copy="other" />
    <sound class="result" key="vehicle" copy="other" />
    <sound class="result" key="character" copy="other" />




    <effect class="result" key="terrain" ref="BigBurst" use_surface_color="1" />
    <effect class="result" key="terrain" ref="SmokeTop" post_processing="1" />
    <effect class="result" key="terrain" ref="Smoke" post_processing="1" />
    <effect class="result" key="terrain" ref="SmokeBurst" post_processing="1" />  
    <effect class="result" key="terrain" ref="BurstShine" lighting="0" />
    <effect class="result" key="terrain" ref="Godray" lighting="0" />
    <effect class="result" key="terrain" ref="ShadowSmoke" shadow="1" />
    <effect class="result" type="splat_map" surface_tag="" size="5.0" atlas_index="0" layer="1" />
    <effect class="result" type="splat_map" surface_tag="" size="6.5" atlas_index="4" layer="0" />
    <effect class="result" type="splat_map" surface_tag="" size="8.0" atlas_index="0" layer="2" additive="0" /> <!-- remove top snow everywhere -->

    <effect class="result" key="other" ref="SmokeTop" post_processing="1" />
    <effect class="result" key="other" ref="Smoke" post_processing="1" />
    <effect class="result" key="other" ref="Shine" lighting="0" />
    <effect class="result" key="other" ref="Godray" lighting="0" />
    <effect class="result" key="other" ref="ShadowSmoke" shadow="1" />

    <effect class="result" key="static_object" copy="terrain" />
    <effect class="result" key="vehicle" copy="terrain" />
    <effect class="result" key="character" copy="terrain" />
	
    <effect class="activated" ref="Propulsion_gl" />

        <!-- GRENADE EFFECTS HEAVY INFANTRY -->
       <effect class="result" key="terrain" ref="xExpFog" />
    <effect class="result" key="terrain" ref="xSmallExpRise" />
    <effect class="result" key="terrain" ref="xSmallDirtExp" use_surface_color="1" />
    <effect class="result" key="terrain" ref="xSmallExpSmoke2" />
    <effect class="result" key="terrain" ref="xCannonFlash" />		
    <effect class="result" key="terrain" ref="xCannonFlash2" />
    <effect class="result" key="terrain" ref="xShieldBurst2" />	
    <effect class="result" key="terrain" ref="xcannon_round" lighting="0" />
    <effect class="result" key="terrain" ref="xcannon_round2" lighting="0" />
    <effect class="result" type="splat_map" surface_tag="" size="3.5" atlas_index="0" layer="1" />
    <effect class="result" type="splat_map" surface_tag="" size="4.5" atlas_index="4" layer="0" />
    <effect class="result" type="splat_map" surface_tag="" size="5.5" atlas_index="0" layer="2" additive="0" /> <!-- remove top snow everywhere -->

    <effect class="result" key="other" ref="xExpFog" />
    <effect class="result" key="other" ref="xSmallExpRise" />
    <effect class="result" key="other" ref="xSmallExpSmoke2" />
    <effect class="result" key="other" ref="xCannonFlash" />
    <effect class="result" key="other" ref="xCannonFlash2" />
    <effect class="result" key="other" ref="xShieldBurst2" />
    <effect class="result" key="other" ref="xcannon_round" lighting="0" />
    <effect class="result" key="other" ref="xcannon_round2" lighting="0" />

    <effect class="result" key="vehicle" ref="xExpFog" />
    <effect class="result" key="vehicle" ref="xAtBurstSmall" />
    <effect class="result" key="vehicle" ref="xSmallExpRise" />
    <effect class="result" key="vehicle" ref="xSmallExpSmoke2" />
    <effect class="result" key="vehicle" ref="xCannonFlash" />
    <effect class="result" key="vehicle" ref="xCannonFlash2" />
    <effect class="result" key="vehicle" ref="xShieldBurst2" />
    <effect class="result" key="vehicle" ref="xcannon_round" lighting="0" />
    <effect class="result" key="vehicle" ref="xcannon_round2" lighting="0" />
  <!-- GRENADE EFFECTS HEAVY INFANTRY end -->




</projectile>
