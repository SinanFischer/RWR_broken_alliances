<?xml version="1.0" encoding="utf-8"?>
<!-- media/packages/RWR_broken_alliances/weapons/m1917_savage_lewis.weapon -->
<weapon file="base_primary_rare.weapon" key="m1917_savage_lewis.weapon">
    <tag name="machine gun" />
    <specification
    retrigger_time="0.10"
    accuracy_factor="0.82"
    sustained_fire_grow_step="0.02"
    sustained_fire_diminish_rate="0.12"
    spread_range="0.28"
    magazine_size="165"
    can_shoot_standing="1"
    can_shoot_crouching="1"
    suppressed="0"
    name="M1917 Savage-Lewis"
    class="0"
    barrel_offset="0.7"
    projectile_speed="100.0"
    cooldown_start="0.75"
    cooldown_end="0.0"/>

    <animation state_key="recoil" animation_key="recoil, hip fire" />
    <animation state_key="recoil" animation_key="recoil2, hip fire" />
    <animation state_key="recoil" animation_key="recoil3, hip fire" />
    <animation key="recoil" stance_key="over_wall" ref="12" />
    <animation key="recoil" stance_key="over_wall" ref="13" />
    <animation key="recoil" stance_key="over_wall" ref="14" />
    <animation state_key="hold" animation_key="hold, lmg" />
    <animation key="reload" ref="33" />
    <animation key="hold_on_wall" ref="1" />
    <animation state_key="walking" animation_key="walking, hip fire" />
    <animation state_key="crouching" animation_key="crouch, hold, hip fire" />
    <animation state_key="crouch_moving" animation_key="crouching forwards, hip fire" />

    <!-- Suppression-Master: Kaum Streuungsanstieg, flexibel in allen Positionen -->
    <stance state_key="running"   accuracy="0.35" />
    <stance state_key="walking"   accuracy="0.70" />
    <stance state_key="standing"  accuracy="0.70" />
    <stance state_key="crouching" accuracy="0.72" />
    <stance state_key="prone"     accuracy="0.80" />
    <stance state_key="over_wall" accuracy="0.70" />

    <weak_hand_hold offset="0.4" />

    <sound key="fire" fileref="gun_lewis_shot.wav" pitch_variety="0.05" volume="0.4" />
    <sound key="cooldown" fileref="overheating_mg.wav" volume="0.4"/>
    <sound key="effect" fileref="hunter_cycle_in.wav" volume="0.8"/>
    <sound key="magazine_out" fileref="mg_clip_out.wav" />
    <sound key="magazine_in" fileref="mg_clip_in.wav" />
    <sound key="cycle" fileref="rifle_chamber.wav" />

    <model filename="gun_lewis.xml" />
    <hud_icon filename="hud_gun_lewis.png" />

    <commonness value="0.03" can_respawn_with="1" in_stock="1"/>
    <inventory encumbrance="11.0" price="200.0" />

    <projectile file="bullet.projectile">
        <result
        class="hit"
        kill_probability="0.58"
        kill_decay_start_time="0.40"
        kill_decay_end_time="0.65"
        />
    </projectile>

    <modifier class="speed" value="-0.20" />
</weapon>
