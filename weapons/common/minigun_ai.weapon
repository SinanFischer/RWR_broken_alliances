<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_rare.weapon" key="minigun_ai.weapon"time_to_live_out_in_the_open="150.0" drop_count_factor_on_death="0.0" player_death_drop_owner_lock_time="45.0">
    <tag name="machine gun" />
    <specification 
  retrigger_time="0.012" 
  accuracy_factor="0.80" 
  spread_range="0.20"
  sustained_fire_grow_step="1.5" 
  sustained_fire_diminish_rate="0.7" 
    sight_range_modifier="1.6" 
  magazine_size="9999999" 
  can_shoot_standing="1" 
  can_shoot_crouching="1" 
  can_shoot_prone="0"
  suppressed="0" 
  name="GAU-17 MOBILE" 
  class="0" 
