<?xml version="1.0" encoding="utf-8"?>
<weapon key="deployable_mg.weapon">
    <specification retrigger_time="0.096" 
    accuracy_factor="0.92" 
    sustained_fire_grow_step="1.2" 
    sustained_fire_diminish_rate="0.4" 
    sight_range_modifier="1.15" ai_sight_range_modifier="1.035" 
    magazine_size="-1" 
    can_shoot_standing="0" 
    can_shoot_crouching="0" 
    suppressed="0" 
    name="MG" 
    class="0" 
    projectile_speed="165.0" 
    slot="2" 
    barrel_offset="1.0" 
    projectiles_per_shot="1" 
    sight_height_offset="2.0"
    cooldown_start="2.7"
    cooldown_end="0.0" />
	
	<capacity value="0" source="rank" source_value="0.0" />
    <capacity value="1" source="rank" source_value="0.08" />

    <model mesh_filename="deployable_mg.mesh" texture_filename="deployable_mg.png" />
    <hud_icon filename="hud_deployable_mg.png" />
    <commonness value="0.0" can_respawn_with="0" />
    <inventory encumbrance="5.0" price="55.0" />    
  
    <projectile file="bullet.projectile">
        <result class="hit" kill_probability="1.4" kill_decay_start_time="0.41" kill_decay_end_time="0.71" />
