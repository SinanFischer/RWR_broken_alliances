<?xml version="1.0" encoding="utf-8"?>
<weapon key="wiesel_mk20.weapon">
    <specification retrigger_time="0.35"
    accuracy_factor="0.95"
    sustained_fire_grow_step="1.2"
    sustained_fire_diminish_rate="1.2"
    sight_range_modifier="1.0" ai_sight_range_modifier="0.9"
    magazine_size="-1"
    can_shoot_standing="0"
    can_shoot_crouching="0"
    suppressed="0"
    name="Wiesel Mk20"
    class="0"
    projectile_speed="140.0"
    slot="2" barrel_offset="1.2"
    projectiles_per_shot="1" />
    <model mesh_filename="wiesel_mk20_cannon.mesh" texture_filename="wiesel_mk20_turret.png" />
    <hud_icon filename="hud_apc.png" />
    <commonness value="0.0" />
    <projectile file="wiesel_mk20.projectile" />

    <target_factors tag="" distance="1.0" direction="0.0" squad_command="1.0" base_score="0.5" />
    <target_factors tag="metal_heavy" distance="1.0" direction="0.0" squad_command="1.0" base_score="3.0" />
    <target_factors tag="apc" distance="1.0" direction="0.0" squad_command="1.0" base_score="5.0" />
    <target_factors tag="light_combat" distance="1.0" direction="0.0" squad_command="1.0" base_score="6.0" />
    <target_factors tag="defensive_at" distance="1.0" direction="0.0" squad_command="1.0" base_score="7.0" />
    <target_factors tag="tactical" distance="1.0" direction="0.0" squad_command="1.0" base_score="8.0" />
    <target_factors tag="bazooka" distance="1.0" direction="0.0" squad_command="1.0" base_score="10" />

    <!-- Mündung wie APC-Autokanone (HI); kinetisch - kein HE-Einschlag, nur Rohrblitz/Rauch wie apc_hmg -->
    <effect class="muzzle" ref="xMuzzleCasingThrowBounce" />
    <effect class="muzzle" ref="xMuzzleFog" />
    <effect class="muzzle" ref="xMuzzleDust" />
    <effect class="muzzle" ref="xLargeRifleFlash" />
    <effect class="muzzle" ref="xBig3Muzzle" />

    <sound class="operation" key="fire" fileref="wiesel_mk20_shot.wav" />

</weapon>
