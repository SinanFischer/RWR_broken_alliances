<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary.weapon" key="g28.weapon">
	<tag name="sniper" />
    <specification 
	retrigger_time="0.65" 
         spread_range="0.4"
  	accuracy_factor="0.95" 
	sustained_fire_grow_step="1.2" 
	sustained_fire_diminish_rate="1.3" 
	magazine_size="20" 
	can_shoot_standing="1" 
	suppressed="0" 
	name="G28" 
	class="4" 
	burst_shots="1"
	reload_one_at_a_time="0" 
	sight_range_modifier="1.95" 
	projectile_speed="215.0"
	barrel_offset="0.6" 
	projectiles_per_shot="1" /> <!--275-->

    <animation key="recoil" ref="27" />
    <animation key="cycle" ref="30" />
    <animation state_key="reload" animation_key="reloading, dragunov_svd" />

    <sound key="fire" fileref="m14_ebr.wav" pitch_variety="0.05" volume="1.3"/>
    <sound key="cycle" fileref="sniper_cycle.wav" />
    <sound key="magazine_out" fileref="sniper_clip_out.wav" />
    <sound key="magazine_in" fileref="sniper_clip_in.wav" />
    <sound key="cycle_out" fileref="sniper_cycle_out.wav" />
    <sound key="cycle_in" fileref="sniper_cycle_in.wav" />
    <sound class="impact" fileref="rifle_drop.wav" />

    <model filename="g28.xml" />
    <hud_icon filename="hud_g28.png" />
    <commonness value="0.01" />
    <inventory encumbrance="6.0" price="12" />

    <projectiles_per_shot value="1" />
    <weak_hand_hold offset="0.3" />

    <projectile file="bullet.projectile">
        <result 
		class="hit" 
		kill_probability="0.90" 
		kill_decay_start_time="0.1" 
		kill_decay_end_time="2.0" />
    </projectile>

    <stance state_key="running" accuracy="0.1" />
    <stance state_key="walking" accuracy="0.72" />
    <stance state_key="crouch_moving" accuracy="0.8" />
    <stance state_key="prone_moving" accuracy="0.82" />

    <stance state_key="standing" accuracy="0.92" />
    <stance state_key="crouching" accuracy="0.95" />
    <stance state_key="prone" accuracy="1.0" />

    <modifier class="speed" value="-0.07" />
</weapon>
