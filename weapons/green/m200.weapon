<?xml version="1.0" encoding="utf-8"?>
<weapon file="base_primary_rare.weapon" key="m200.weapon" drop_count_factor_on_death="1.0" drop_count_factor_on_player_death="1.0">
    <tag name="sniper" />
    <specification 
                retrigger_time="2.2" 
	accuracy_factor="1.2" 
	spread_range="0.8"
	sustained_fire_grow_step="10.0" 
	sustained_fire_diminish_rate="0.5" 
	magazine_size="7" 
	can_shoot_standing="0" 
	suppressed="0" 
	name="CheyTac M200" 
	class="2" 
	reload_one_at_a_time="0" 
	sight_range_modifier="2.6" 
	projectile_speed="280.0" 
	barrel_offset="0.5" 
	projectiles_per_shot="2" />
 
    <animation key="recoil" ref="27" />
