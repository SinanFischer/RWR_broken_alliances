<?xml version="1.0" encoding="utf-8"?>
<weapon drop_count_factor_on_death="0.40" drop_count_factor_on_player_death="1.0" file="base_secondary.weapon" key="javelin_elite.weapon" time_to_live_out_in_the_open="90.0">
