    <model filename="javelin.xml" />

    <ballistics curve_height="8.0" near_far_distance="0.0" speed_estimation_near="20.0" speed_estimation_far="40.0" max_speed="70.0" randomness="0.0" tweak_factor="1.1" />

    <projectile file="javelin_elite.projectile" />
    <weak_hand_hold offset="-0.35" />

    <!-- source_value: Basis-Javelin-Werte * 1.5 → 1.875 / 2.025 / 2.4 -->
