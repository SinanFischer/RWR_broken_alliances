<?xml version="1.0" encoding="utf-8"?>
<!-- BA: Submunition — EXPLOSION_EFFECT_TIERS Stufe 1 (Granate/Cluster), vgl. hand_grenade.projectile -->
<projectile class="grenade" name="M528 AP" slot="2" pulldown_in_air="50.0" key="m528_apj_sub.projectile" >
    <result class="blast" radius="2.5" damage="0.16" push="0.1" decal="0" />
    <trigger class="impact" />
    <rotation class="motion" />

    <model mesh_filename="paw20_round.xml" />

    <sound class="result" key="other" fileref="explosion5.wav" />

    <commonness value="0.0" can_respawn_with="0" in_stock="0"/>

    <sound class="result" key="terrain" copy="other" />
    <sound class="result" key="static_object" copy="other" />
    <sound class="result" key="vehicle" copy="other" />
    <sound class="result" key="character" copy="other" />

    <effect class="result" key="terrain" ref="BigBurst" use_surface_color="1" />
