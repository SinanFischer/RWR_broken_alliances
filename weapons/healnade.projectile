<?xml version="1.0" encoding="utf-8"?>
<projectile class="grenade" name="Heal Grenade" slot="0" radius="0.15" key="healnade.projectile">
    <tag name="flashbang" />

    <result class="blast" radius="6" damage="0.0" push="0.0" decal="0" character_state="unwound" />
    <trigger class="impact" />
    <rotation class="random" />
    <model mesh_filename="healnade.xml" />
    <hud_icon filename="hud_healnade.png" />

    <!-- projectile slot 0 is used for hand grenade items currently -->
    <!-- bound to change -->
    <commonness value="0.00" />
    <capacity value="2" source="rank" source_value="0.0" />
    <capacity value="4" source="rank" source_value="0.2" />
    <inventory encumbrance="3.0" price="25.0" />

    <throwable curve_height="5.5" near_far_distance="8.0" speed_estimation_near="13.0" speed_estimation_far="20.0" max_speed="25.0" randomness="0.07" />

    <sound class="result" key="other" fileref="healnade.wav" />

    <sound class="result" key="terrain" copy="other" />
    <sound class="result" key="static_object" copy="other" />
    <sound class="result" key="vehicle" copy="other" />
    <sound class="result" key="character" copy="other" />

    <effect class="result" key="terrain" ref="BigBurst" use_surface_color="1" />
    <effect class="result" key="terrain" ref="FlashShine_healnade" lighting="0" />
    <effect class="result" key="terrain" ref="FlashBeam_healnade" lighting="0" />

    <effect class="result" key="other" ref="FlashShine_healnade" lighting="0" />
    <effect class="result" key="other" ref="FlashBeam_healnade" lighting="0" />

    <effect class="result" key="static_object" copy="terrain" />
    <effect class="result" key="vehicle" copy="terrain" />
    <effect class="result" key="character" copy="terrain" />

</projectile>
