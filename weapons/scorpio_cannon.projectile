<?xml version="1.0" encoding="utf-8"?>
<!-- Mod: Aufprall wie m72_law_rocket (xMed*); Blast/Sound Vanilla-Skorpio -->
<projectile class="grenade" name="Scorpio 76mm HESH" slot="1" pulldown_in_air="8.0" key="scorpio_cannon.projectile">
    <tag name="rocket"/>
    <result class="blast" 
    radius="7.0" 
    damage="1000" 
    push="1.0" 
    decal="1"
    damage_origin_vehicle="0"
    />
        
    <trigger class="impact" />
    <rotation class="motion" />
    <model mesh_filename="76mm_hesh.xml" />

    <commonness value="0.0" />

    <sound class="result" key="other" fileref="explosion1.wav" volume="0.85"/>
    <sound class="result" key="other" fileref="explosion2.wav" volume="0.85"/>
    <sound class="result" key="terrain" copy="other" />
    <sound class="result" key="static_object" copy="other" />
    <sound class="result" key="vehicle" copy="other" />
    <sound class="result" key="character" copy="other" />

    <effect class="result" key="terrain" tag="ice" ref="IceCrackBig" post_processing="0" />
    <effect class="result" key="terrain" tag="ice" ref="IceCrackRing" post_processing="0" />     
    <effect class="result" key="terrain" tag="ice" ref="IceBurstBig" use_surface_color="1" />       
    <effect class="result" key="terrain" tag="ice" ref="SmokeTop" post_processing="1" />
    <effect class="result" key="terrain" tag="ice" ref="Smoke" post_processing="1" />
    <effect class="result" key="terrain" tag="ice" ref="Shine" lighting="0" />
    <effect class="result" key="terrain" tag="ice" ref="Godray" lighting="0" />
    <effect class="result" key="terrain" tag="ice" ref="ShadowSmoke" shadow="1" />
    <effect class="result" key="terrain" tag="ice" ref="woosh" post_processing="0" shadow="0" />      
    <effect class="result" type="splat_map" surface_tag="ice" size="4.5" atlas_index="4" layer="0" />

    <!-- Vanilla-Basis + HI mittlere AT-Rakete (gleiche Kette wie m72_law_rocket.projectile) -->
    <effect class="result" key="terrain" ref="BigBurst" use_surface_color="1" />
    <effect class="result" key="terrain" ref="SmokeTop" post_processing="1" />
    <effect class="result" key="terrain" ref="Smoke" post_processing="1" />
    <effect class="result" key="terrain" ref="Shine" lighting="0" />
    <effect class="result" key="terrain" ref="Godray" lighting="0" />
    <effect class="result" key="terrain" ref="ShadowSmoke" shadow="1" />
    <effect class="result" type="splat_map" surface_tag="" size="5.0" atlas_index="0" layer="1" />
    <effect class="result" type="splat_map" surface_tag="" size="6.5" atlas_index="4" layer="0" />
    <effect class="result" type="splat_map" surface_tag="" size="8.0" atlas_index="0" layer="2" additive="0" />

    <effect class="result" key="other" ref="SmokeTop" post_processing="1" />
    <effect class="result" key="other" ref="Smoke" post_processing="1" />
    <effect class="result" key="other" ref="Shine" lighting="0" />
    <effect class="result" key="other" ref="Godray" lighting="0" />
    <effect class="result" key="other" ref="ShadowSmoke" shadow="1" />

    <!-- HI explosion ~60% (medium AT rocket) -->
    <effect class="result" key="terrain" ref="xMedExpFog" />
    <effect class="result" key="terrain" ref="xMedExpRise" />
    <effect class="result" key="terrain" ref="xMedDirtExp" use_surface_color="1" />
    <effect class="result" key="terrain" ref="xMedExpSmoke" />
    <effect class="result" key="terrain" ref="xMedExpSmoke2" />
    <effect class="result" key="terrain" ref="xMedExpFlash" />
    <effect class="result" key="terrain" ref="xMedExpFlash2" />
    <effect class="result" key="terrain" ref="xMedShieldBurst2" />
    <effect class="result" key="terrain" ref="xMedGrenade" lighting="0" />
    <effect class="result" key="terrain" ref="xMedGrenade2" lighting="0" />
    <effect class="result" type="splat_map" surface_tag="" size="3.0" atlas_index="0" layer="1" />
    <effect class="result" type="splat_map" surface_tag="" size="3.9" atlas_index="4" layer="0" />
    <effect class="result" type="splat_map" surface_tag="" size="4.5" atlas_index="0" layer="2" additive="0" />

    <effect class="result" key="other" ref="xMedExpFog" />
    <effect class="result" key="other" ref="xMedExpRise" />
    <effect class="result" key="other" ref="xMedExpSmoke" />
    <effect class="result" key="other" ref="xMedExpSmoke2" />
    <effect class="result" key="other" ref="xMedExpFlash" />
    <effect class="result" key="other" ref="xMedExpFlash2" />
    <effect class="result" key="other" ref="xMedShieldBurst2" />
    <effect class="result" key="other" ref="xMedGrenade" lighting="0" />
    <effect class="result" key="other" ref="xMedGrenade2" lighting="0" />

    <effect class="result" key="static_object" copy="terrain" /> 
    <effect class="result" key="vehicle" copy="terrain" />     
    <effect class="result" key="character" copy="terrain" />

    <effect class="activated" ref="Propulsion" />

</projectile>
