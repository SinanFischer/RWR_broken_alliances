<?xml version="1.0" encoding="utf-8"?>
<!-- media/packages/RWR_broken_alliances/weapons/mg08_heavy_custom22.weapon -->
<weapon drop_count_factor_on_death="0.50" drop_count_factor_on_player_death="1.0" file="base_primary_rare_machinegun_heavy.weapon" key="mg08_heavy_custom22.weapon">
    <tag name="machinegun" />
    <specification
    retrigger_time="0.07"
    last_burst_retrigger_time="0.1"
    accuracy_factor="0.92"
    sustained_fire_grow_step="0.7"
    sustained_fire_diminish_rate="0.50"
    spread_range="0.2"
    magazine_size="60"
    can_shoot_standing="1"
    can_shoot_crouching="1"
    suppressed="0"
    name="MG-08 Heavy CustoM22"
    class="4"
    burst_shots="6"
    projectile_speed="120.0"
    barrel_offset="0.4" />

    <next_in_chain key="ares_shrike_s.weapon" share_ammo="1" />

    <animation key="recoil" ref="12" />
    <animation key="recoil" ref="13" />
    <animation key="recoil" ref="14" />
    <animation key="reload" ref="35" />
    <animation state_key="next_in_chain_in" animation_key="switch fire mode" />

    <sound key="fire" fileref="ares_shrike_shot.wav" pitch_variety="0.04" volume="0.7" />
    <sound key="magazine_out" fileref="mg_clip_out.wav" />
    <sound key="magazine_in" fileref="mg_clip_in.wav" />
    <sound key="cycle" fileref="rifle_chamber.wav" />
    <sound class="impact" fileref="rifle_drop.wav" />
    <model filename="ares_shrike.xml" />

    <hud_icon filename="hud_ares_shrike.png" />
    <commonness value="0.004" can_respawn_with="1" in_stock="1" />
    <inventory encumbrance="10.0" price="54" />

    <weak_hand_hold offset="0.2" />
    <projectile file="bullet.projectile">
        <result class="hit" kill_probability="0.68" kill_decay_start_time="0.35" kill_decay_end_time="0.65" />
    </projectile>

    <!-- Stehend/Laufend nutzbar, aber 0.2 Malus; kniend/liegend präzise -->
    <stance state_key="running"      accuracy="0.3" />
    <stance state_key="walking"      accuracy="0.5" />
    <stance state_key="standing"     accuracy="0.6" />
    <stance state_key="crouch_moving" accuracy="0.10" />
    <stance state_key="crouching"    accuracy="0.85" />
    <stance state_key="prone"        accuracy="0.92" />
    <stance state_key="prone_moving" accuracy="0.10" />
    <stance state_key="over_wall"    accuracy="0.90" />

    <modifier class="speed" value="-0.07" />
</weapon>
