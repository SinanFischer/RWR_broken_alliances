// Fallback für Meshes mit _missing_material_ (SubEntity ohne zugewiesenes Material).
// Verhindert "Material _missing_material_ does not exist" im Log.
material _missing_material_
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.6 0.6 0.6 1.0
            diffuse 0.5 0.5 0.5 1.0
            specular 0.2 0.2 0.2 1.0 12.5
            texture_unit
            {
                texture tank2.png
            }
        }
    }
}
