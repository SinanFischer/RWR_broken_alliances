<?xml version="1.0" encoding="utf-8"?>
<call 	name="4 paratroopers" key="paratroopers1.call"
	initiation_comment1="Reinforcements"
	initiation_comment2="Airbone squad"
	acknowledge_comment="Roger, reinforcements enroute"
	launch_comment="5 arriving on location">

    <round instances="4"
           instance_class="soldier"
	   instance_key="default"
           instance_spread="10 15 10" 
           common_spread="0 0 0" 
           launch_time="4.0"
           spawn_time="6.0">

        <effect class="launch" ref="ShadowAirplaneFlyby" shadow="1" />
        <sound class="launch" fileref="plane_flyby.wav" />
		
    </round>

    <round instances="1"
           instance_class="soldier"
	   instance_key="medic"
           instance_spread="10 15 10" 
           common_spread="0 0 0" 
           launch_time="3.0"
           spawn_time="6.0">
    </round>

    <hud_icon filename="hud_paratroopers1.png" />
    <capacity value="0" source="rank" source_value="0.0" />
    <capacity value="100" source="rank" source_value="0.275" />
    <inventory encumbrance="0.0" price="170.0" />

</call>
