<?xml version="1.0" encoding="utf-8"?>
<call name="spawn vulcan tank" key="vulcan_tank.call"
      initiation_comment1="Requesting vulcan tank drop"
      acknowledge_comment="Confirmed, vulcan enroute"
      launch_comment="Airdropping vulcan tank now">

    <round instances="1"
           instance_class="vehicle"
           instance_key="vulcan_tank.vehicle" 
           instance_spread="0 0 0" 
           common_spread="0 0 0" 
           launch_time="18.0"
           spawn_time="10.0"
           horizontal_offset_at_spawn="0.0"
           vertical_offset_at_spawn="40.0"
           initial_speed_to_target="0.0">
        <effect class="launch" ref="ShadowAirplaneFlyby" shadow="1" />
        <sound class="launch" fileref="plane_flyby.wav" />
    </round>

    <hud_icon filename="hud_tank.png" />
    <capacity value="0" source="rank" source_value="0.0" />
    <capacity value="100" source="rank" source_value="0.67" />
    <inventory encumbrance="0.0" price="450.0" />

</call>
