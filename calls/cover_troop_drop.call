<?xml version="1.0" encoding="utf-8"?>
<call name="Wiesel Drop" key="cover_troop_drop.call"
	initiation_comment1="Reinforcements"
	initiation_comment2="Wiesel TOW"
	acknowledge_comment="Roger, Wiesel enroute"
	launch_comment="ETA 8 Sierra">

    <round instances="1"
           instance_class="vehicle"
           instance_key="wiesel_tow.vehicle"
           instance_spread="2 0 2"
           common_spread="0 0 0"
           launch_time="5.0"
           spawn_time="8.0"
           horizontal_offset_at_spawn="0.0"
           vertical_offset_at_spawn="50.0"
           initial_speed_to_target="0.0">

        <effect class="launch" ref="ShadowAirplaneFlyby" shadow="1" />
        <sound class="launch" fileref="plane_flyby.wav" />
    </round>

    <hud_icon filename="hud_paratroopers3.png" />
    <capacity value="0" source="rank" source_value="0.0" />
    <capacity value="100" source="rank" source_value="1.0" />
    <inventory encumbrance="0.0" price="550.0" />

</call>
