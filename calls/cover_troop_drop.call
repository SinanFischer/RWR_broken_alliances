<?xml version="1.0" encoding="utf-8"?>
<call name="Verstärkung - 4 Cover Troops" key="cover_troop_drop.call"
      initiation_comment1="Verstärkung anfordern"
      initiation_comment2="4 Cover Troops anfordern"
      acknowledge_comment="Verstanden, 4 Cover Troops unterwegs"
      launch_comment="Cover Troops erreichen Ziel">

    <round instances="4"
           instance_class="soldier"
           instance_key="cover_troop"
           instance_spread="10 15 10"
           common_spread="0 0 0"
           launch_time="5.0"
           spawn_time="8.0">

        <effect class="launch" ref="ShadowAirplaneFlyby" shadow="1" />
        <sound class="launch" fileref="plane_flyby.wav" />
    </round>

    <hud_icon filename="hud_paratroopers3.png" />
    <capacity value="0" source="rank" source_value="0.0" />
    <capacity value="100" source="rank" source_value="1.0" />
    <inventory encumbrance="0.0" price="250.0" />

</call>
