<?xml version="1.0" encoding="utf-8"?>
<call name="8 paratroopers" key="paratroopers2.call"
	initiation_comment1="Reinforcements"
	initiation_comment2="Airbone platoon"
	acknowledge_comment="Roger, reinforcements enroute"
	launch_comment="ETA 8 Sierra">

    <round instances="7"
           instance_class="soldier"
	   instance_key="default"
           instance_spread="10 15 10" 
           common_spread="0 0 0" 
           launch_time="8.0"
           spawn_time="11.0">

        <effect class="launch" ref="ShadowAirplaneFlyby" shadow="1" />
        <sound class="launch" fileref="plane_flyby.wav" />
		
    </round>

    <round instances="2"
           instance_class="soldier"
	   instance_key="medic"
           instance_spread="10 15 10" 
           common_spread="0 0 0" 
           launch_time="7.0"
           spawn_time="11.0">
    </round>

    <round instances="1"
           instance_class="soldier"
	   instance_key="miniboss"
           instance_spread="8 5 8" 
           common_spread="0 0 0" 
           launch_time="8.0"
           spawn_time="11.6">
    </round>


    <hud_icon filename="hud_paratroopers2.png" />
    <capacity value="0" source="rank" source_value="0.0" />
    <capacity value="100" source="rank" source_value="0.3" />
    <inventory encumbrance="0.0" price="270.0" />

</call>
