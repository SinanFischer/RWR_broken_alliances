<?xml version="1.0" encoding="utf-8"?>
<call 	name="minefield drop (1x8)" key="mines.call"
	initiation_comment1="Requesting minefield support."
	acknowledge_comment="Copy, wait six."
	launch_comment="Mine field dropping on location">

    <round instances="6"
           instance_class="grenade"
		   instance_key="at_mine.projectile" 
           instance_spread="10 10 10" 
           common_spread="0 0 0" 
           launch_time="15.0"
           spawn_time="9.0">

        <effect class="launch" ref="ShadowAirplaneFlyby" shadow="1" />
        <sound class="launch" fileref="plane_flyby.wav" />
		<sound class="spawn" fileref="woosh1.wav" volume="0.2" />
    </round>

    <hud_icon filename="hud_at_mine.png" />
    <capacity value="0" source="rank" source_value="0.0" />
    <capacity value="100" source="rank" source_value="0.62" />
    <inventory encumbrance="0.0" price="130.0" />

</call>
