<?xml version="1.0" encoding="utf-8"?>
<call name="Tank Drop (Leopold II)" key="tank_1.call"
           initiation_comment1="Requesting Leopold II Tank Drop"
           acknowledge_comment="Confirmed, tank enroute"
           launch_comment="Tank on its way down">

    <round instances="1"
           instance_class="vehicle"
           instance_key="tank_1.vehicle" 
           instance_spread="0 0 0" 
           common_spread="0 0 0" 
           launch_time="17.0"
           spawn_time="8.0"
           horizontal_offset_at_spawn="0.0"
           vertical_offset_at_spawn="40.0"
           initial_speed_to_target="0.0">
        <effect class="launch" ref="ShadowAirplaneFlyby" shadow="1" />
        <sound class="launch" fileref="plane_flyby.wav" />
    </round>

    <hud_icon filename="hud_tank.png" />
    <capacity value="0" source="rank" source_value="0.0" />
    <capacity value="100" source="rank" source_value="1.0" />
    <inventory encumbrance="0.0" price="1200.0" />

</call>
