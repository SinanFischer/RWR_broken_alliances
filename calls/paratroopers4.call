<?xml version="1.0" encoding="utf-8"?>
<call name="20 paratroopers" key="paratroopers4.call"
	initiation_comment1="Reinforcements"
	initiation_comment2="airbone company"
	acknowledge_comment="Roger, reinforcements enroute"
	launch_comment="ETA 8 Sierra. good luck, soldiers.">

    <round instances="10"
           instance_class="soldier"
	   instance_key="default"
           instance_spread="15 15 15" 
           common_spread="0 0 0" 
           launch_time="8.0"
