<?xml version="1.0" encoding="utf-8"?>
<call name="Close air support (4x2)" key="tactical_strike.call"
      initiation_comment1="Requesting tactical airstrike"
      acknowledge_time="2.0"
      acknowledge_comment="Roger, ground attacker enroute."
      launch_comment="Bomb dropped on target.">

    <round instances="2"
           instance_class="grenade"
           instance_key="bomb1.projectile" 
           instance_spread="0 0 0" 
           common_spread="0 0 2" 
           launch_time="3.5"
           spawn_time="5.0">

        <effect class="launch" ref="ShadowAirstrikeFlyby" shadow="1" />
		<sound class="launch" fileref="a10.wav" volume="0.6"  />
		<sound class="spawn" fileref="railway_shell_whistle.wav" volume="1.0" />       </round>

    <hud_icon filename="A10BankingHard.png" />
    <capacity value="0" source="rank" source_value="0.0" />
    <capacity value="100" source="rank" source_value="0.3" />
    <inventory encumbrance="0.0" price="225.0" />

</call>
