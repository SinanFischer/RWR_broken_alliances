<?xml version="1.0" encoding="utf-8"?>
<call name="Deckungstruppe (5)" key="mg5_drop.call"
      initiation_comment1="I need cover troops"
      initiation_comment2="Requesting 5 cover squad"
      acknowledge_comment="Roger, 5 cover troops enroute"
      launch_comment="Cover squad arriving on location">

    <round instances="5"
           instance_class="soldier"
           instance_key="cover_troop"
           instance_spread="10 15 10"
           common_spread="0 0 0"
           launch_time="5.0"
           spawn_time="8.0">

        <effect class="launch" ref="ShadowAirplaneFlyby" shadow="1" />
        <sound class="launch" fileref="plane_flyby.wav" />
    </round>

    <hud_icon filename="hud_paratroopers3.png" />
    <capacity value="0" source="rank" source_value="0.0" />
    <capacity value="100" source="rank" source_value="1.0" />
    <inventory encumbrance="0.0" price="300.0" />

</call>
