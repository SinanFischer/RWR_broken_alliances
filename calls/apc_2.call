<?xml version="1.0" encoding="utf-8"?>
<call name="drop BTX APC" key="apc_2.call"
      initiation_comment1="Requesting IFV drop"
      acknowledge_comment="Confirmed, IFV enroute"
      launch_comment="IFV on its way down">

    <round instances="1"
           instance_class="vehicle"
           instance_key="apc_2.vehicle" 
           instance_spread="0 0 0" 
           common_spread="0 0 0" 
           launch_time="6.0"
           spawn_time="16.0"
           horizontal_offset_at_spawn="0.0"
           vertical_offset_at_spawn="50.0"
           initial_speed_to_target="0.0">
        <effect class="launch" ref="ShadowAirplaneFlyby" shadow="1" />
        <sound class="launch" fileref="plane_flyby.wav" />
    </round>

    <hud_icon filename="hud_humveedrop.png" />
    <capacity value="0" source="rank" source_value="0.0" />
    <capacity value="100" source="rank" source_value="0.5" />
    <inventory encumbrance="0.0" price="450.0" />

</call>
