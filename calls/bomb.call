<?xml version="1.0" encoding="utf-8"?>
<call name="tactical airstrike" key="bomb.call"
      initiation_comment1="Requesting tactical airstrike"
      acknowledge_comment="Roger, ground attacker enroute."
      launch_comment="Bomb dropped on target">
     
    <round instances="1"
           instance_class="grenade"
           instance_key="bomb.projectile" 
           instance_spread="0 0 0" 
           common_spread="0 0 2" 
           launch_time="2.5"
           spawn_time="5.0">
		   
		<effect class="launch" ref="ShadowAirplaneFlyby" shadow="1" />
		<sound class="launch" fileref="plane_flyby.wav" />
		<sound class="spawn" fileref="woosh1.wav" volume="1.0" />
    </round>

    <hud_icon filename="hud_impact_grenade.png" />
    <capacity value="0" source="rank" source_value="0.0" />
    <capacity value="100" source="rank" source_value="0.76" />
    <inventory encumbrance="0.0" price="148.0" />

</call>