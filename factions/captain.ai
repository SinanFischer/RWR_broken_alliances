<?xml version="1.0" encoding="utf-8"?>
<!-- Captain AI: Leader vorne, startet mit Guard – wird von orange_bodyguards bewacht -->
<ai filename="default_soldiers.ai">
	<parameter class="force_as_leader" value="1" />
	<!-- Sicht: Leader-Sicht erhöht -->
	<parameter class="max_sight_range_with_muzzle" value="58.0" />
	<parameter class="leader_sight_range" value="50.0" />
	<parameter class="team_member_sight_range" value="48.0" />
	<parameter class="monitor_enemies_max_dot_range" value="2.3" />

	<!-- Reaktionszeiten: sehr schnell (Elite) -->
	<parameter class="day_reaction_time_to_fight_min" value="0.45" />
	<parameter class="day_reaction_time_to_fight_max" value="0.65" />
	<parameter class="night_reaction_time_to_fight_min" value="0.55" />
	<parameter class="night_reaction_time_to_fight_max" value="0.8" />
	<parameter class="choose_enemy_time" value="0.45" />
	<parameter class="monitor_enemies_time" value="0.5" />

	<!-- Basis verteidigen – 100% Guard, NICHT zu Alarmen/angreifenden Zielen laufen (Dog/Chicken-Pattern) -->
	<parameter class="active_guarding_probability" value="1.0" />
	<parameter class="willingness_to_guard" value="1.0" />
	<parameter class="willingness_to_charge" value="0.0" />
	<parameter class="fighting_favor_helping_probability" value="0.0" />
	<parameter class="check_need_for_help_range" value="0.0" />
	<!-- Stay-in-base: 1.0 = reagiert nur auf Alarme direkt am Standort, läuft nicht los -->
	<parameter class="leading_inspect_alarm_spread_out_distance" value="1.0" />
	<parameter class="leading_inspect_alarm_min_distance" value="1.0" />
	<parameter class="fighting_approach_alarm_spread_max_range" value="1.0" />
	<parameter class="fighting_approach_alarm_max_soldiers" value="1" />
	<parameter class="check_alert_time" value="100.0" />

	<!-- Genauigkeit -->
	<parameter class="accuracy_offset" value="0.01" />
	<parameter class="accuracy_penalty_range" value="0.05" />
</ai>
