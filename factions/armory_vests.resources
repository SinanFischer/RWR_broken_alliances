<?xml version="1.0" encoding="utf-8"?>
<!-- Zusaetzliche Westen fuer die Waffenkammer (Default-Gruppe).
     Kein clear_carry_items: wird NACH default_vests.resources geladen, ergaenzt also den Slot-1-Pool.
     Default-Soldaten spawnen weiter nur vest_default, da vest1-4 etc. commonness="0.0" haben. -->
<resources>
	<carry_item key="vest1.carry_item" enabled="1" />
	<carry_item key="vest2.carry_item" enabled="1" />
	<carry_item key="vest3.carry_item" enabled="1" />
	<carry_item key="vest4.carry_item" enabled="1" />
	<carry_item key="eodvest.carry_item" enabled="1" />
	<carry_item key="camouflage_suit.carry_item" enabled="1" />
	<carry_item key="sf_suit.carry_item" enabled="1" />
	<carry_item key="vest_blackops.carry_item" enabled="1" />
	<!-- Laptop/Briefcase-Unlock: dynamisch per faction_resources eingeblendet -->
	<carry_item key="vest_blackops3.carry_item" enabled="0" />
</resources>
