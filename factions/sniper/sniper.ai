<?xml version="1.0" encoding="utf-8"?>
<!-- Sniper-AI: Basis default_soldiers (Reaktion wie vanilla Infanterie), dann Sicht/Cover-Overrides. -->
<ai filename="common_resources/default_soldiers.ai">
  <parameter class="max_sight_range_with_muzzle" value="75.0" />
   <parameter class="force_as_leader" value="1" />
  <parameter class="prefer_roofs_probability" value="0.95" />
    <parameter class="squad_cover_provider_range" value="20.0" />
  <parameter class="squad_cover_provider_offset_factor" value="-0.9" />
    <parameter class="using_cover_min_time" value="7.0" />
  <parameter class="using_cover_max_time" value="60.0" />
    <parameter class="shooting_accuracy_ratio_requirement" value="0.88" />  
    <parameter class="accuracy_penalty_range" value="0.01" />
</ai>
