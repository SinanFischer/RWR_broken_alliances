<?xml version="1.0" encoding="utf-8"?>
<!-- United States: Truppenspezifische Redeweisen nach CHARACTER_VOICE_SPEC.md -->
<character filename="default_male.character">

	<!-- ========== Medic! (Verwundet) ========== -->
	<!-- Militärisch -->
	<comment key="Medic!" text="Corpsman!" />
	<comment key="Medic!" text="Man down! Need medic!" />
	<comment key="Medic!" text="Doc! I'm hit!" />
	<!-- Brutal -->
	<comment key="Medic!" text="I'm fucking hit!" />
	<comment key="Medic!" text="They got me!" />
	<comment key="Medic!" text="Oh shit, I'm hit!" />
	<comment key="Medic!" text="I'm bleeding out!" />
	<!-- Kameradschaftlich -->
	<comment key="Medic!" text="Buddy! Where are you?!" />
	<comment key="Medic!" text="Someone get Doc!" />
	<comment key="Medic!" text="Someone! Anyone! Help!" />
	<!-- Panisch -->
	<comment key="Medic!" text="OH SHIT! I'm hit!" />
	<comment key="Medic!" text="Medic! NOW!" />
	<comment key="Medic!" text="AAAARGH!" />
	<comment key="Medic!" text="NOOOO, not today!" />
	<!-- Traurig - Familie, Kinder, Frau, Freunde -->
	<comment key="Medic!" text="Mom...!" />
	<comment key="Medic!" text="Tell my mom I love her" />
	<comment key="Medic!" text="I don't want to die..." />
	<comment key="Medic!" text="So much blood..." />
	<comment key="Medic!" text="I'll never see my kids again..." />
	<comment key="Medic!" text="Tell my wife I love her..." />
	<comment key="Medic!" text="My kids... they're so young..." />
	<comment key="Medic!" text="I won't make it home..." />
	<comment key="Medic!" text="Tell the boys... tell them I'm sorry..." />
	<!-- Entschlossene Patrioten - trotz Verwundung -->
	<comment key="Medic!" text="For America... get me up!" />
	<comment key="Medic!" text="Not like this... not for freedom..." />
	<comment key="Medic!" text="I won't fall here. MEDIC!" />
	<comment key="Medic!" text="For my country... I need to make it..." />
	<comment key="Medic!" text="Get me back in the fight!" />
	<!-- Politisch/Insider - nur wenn aktiv verwundet -->
	<comment key="Medic!" text="This is fine" />
	<comment key="Medic!" text="Dying for the guys who... forget it" />
	<!-- Absurd/Meta -->
	<comment key="Medic!" text="At least I died for freedom" />
	<comment key="Medic!" text="Murica" />

	<!-- ========== All quiet here (Casual - sagen sie einfach so) ========== -->
	<!-- Politisch/Insider, Apathie - passen besser als Idle-Gerede -->
	<comment key="All quiet here" text="This is what we're dying for...?" />
	<comment key="All quiet here" text="We're out here while they're..." />
	<comment key="All quiet here" text="Tell me again why we're here..." />
	<comment key="All quiet here" text="The files came out and we're still here" />
	<comment key="All quiet here" text="Same shit, different war" />
	<comment key="All quiet here" text="War numbs you after a while" />
	<comment key="All quiet here" text="Too many tours. Can't feel it anymore." />
	<comment key="All quiet here" text="This ain't my first rodeo... or is it?" />
	<comment key="All quiet here" text="At least my student loans are forgiven... oh wait" />
	<comment key="All quiet here" text="*yawns*" />
	<comment key="All quiet here" text="No one there" />
	<comment key="All quiet here" text="Calm before the storm?" />
	<comment key="All quiet here" text="The front's a meat grinder, same as always." />
	<comment key="All quiet here" text="Just two more weeks..." />

	<!-- ========== I feel good! (Nach Heilung) ========== -->
	<comment key="I feel good!" text="Thanks Doc!" />
	<comment key="I feel good!" text="Thanks for the fix!" />
	<comment key="I feel good!" text="That's the good stuff!" />
	<comment key="I feel good!" text="Good to go!" />
	<comment key="I feel good!" text="Back in the fight!" />
	<comment key="I feel good!" text="Oorah... I guess" />

	<!-- ========== Hold on! (Kamerad kommt) ========== -->
	<comment key="Hold on!" text="I'm on my way!" />
	<comment key="Hold on!" text="Hang in there!" />
	<comment key="Hold on!" text="Almost there, buddy!" />
	<comment key="Hold on!" text="Hold on!" />
	<comment key="Hold on!" text="Coming!" />

	<!-- ========== Reloading ========== -->
	<comment key="Reloading" text="Cover me" />
	<comment key="Reloading" text="Reloading!" />
	<comment key="Reloading" text="Cover me!" />
	<comment key="Reloading" text="Give me cover!" />

	<!-- ========== enemy seen ========== -->
	<comment key="enemy seen" text="Over here" />
	<comment key="enemy seen" text="Alert!" />
	<comment key="enemy seen" text="Hostiles!" />
	<comment key="enemy seen" text="Contact!" />
	<comment key="enemy seen" text="Enemy in sight!" />

	<!-- ========== grenade alert ========== -->
	<comment key="grenade alert, grenade tag = grenade" text="Grenade!" />
	<comment key="grenade alert, grenade tag = grenade" text="Look out!" />
	<comment key="grenade alert, grenade tag = grenade" text="OMG grenade" />
	<comment key="grenade alert, grenade tag = flashbang" text="Flashbang!" />
	<comment key="grenade alert, grenade tag = flashbang" text="Look out!" />
	<comment key="grenade alert, grenade tag = rocket" text="Rocket!" />
	<comment key="grenade alert, grenade tag = rocket" text="Incoming!" />

	<!-- ========== Yes sir ========== -->
	<comment key="Yes sir" text="On it" />
	<comment key="Yes sir" text="Roger" />
	<comment key="Yes sir" text="Copy" />
	<comment key="Yes sir" text="On my way" />
	<comment key="Yes sir" text="Got it" />
	<comment key="Yes sir" text="Hell yeah" />

	<!-- ========== celebrating ========== -->
	<comment key="celebrating" text="We won!" />
	<comment key="celebrating" text="I survived!" />
	<comment key="celebrating" text="Not the island I was worried about!" />
	<comment key="celebrating" text="Hell yeah!" />
	<comment key="celebrating" text="Can't believe I'm alive" />
	<comment key="celebrating" text="That was so badass!" />
	<comment key="celebrating" text="We pwned them hard!" />
	<comment key="celebrating" text="Now that's how it's done!" />
	<comment key="celebrating" text="Yeah!" />
	<comment key="celebrating" text="We made it... unlike some people's stories" />

	<!-- ========== Good job, soldiers ========== -->
	<comment key="Good job, soldiers" text="Well done, men" />
	<comment key="Good job, soldiers" text="Good work, soldiers" />
	<comment key="Good job, soldiers" text="Excellent!" />

	<!-- ========== We surrender! ========== -->
	<comment key="We surrender!" text="Don't shoot!" />
	<comment key="We surrender!" text="We surrender!" />
	<comment key="We surrender!" text="We give up! Wasn't worth dying for anyway" />
	<comment key="We surrender!" text="Don't shoot! We surrender!" />

