<?xml version="1.0" encoding="utf-8"?>
<!-- Green Faction (USA): Disillusioned, High-Tech, War-Weary -->
<!-- English, US Military Slang (NATO phonetics, FUBAR/SNAFU, Corpsman, Frag out) -->
<character filename="default_male.character">
	<animations file="models/soldier_animations.xml" />

	<!-- ========== Medic! (Wounded) ========== -->
	<!-- Militärisch / Direct -->
	<comment key="Medic!" text="Medic! I'm hit!" />
	<comment key="Medic!" text="Corpsman! Up!" />
	<comment key="Medic!" text="Man down! Get me a doc!" />
	<!-- Brutal -->
	<comment key="Medic!" text="Fuck! Need a medic!" />
	<comment key="Medic!" text="I'm hit... shit." />
	<comment key="Medic!" text="Something's wrong... I can't feel it." />
	<comment key="Medic!" text="Gut shot. I'm bleeding out." />
	<comment key="Medic!" text="My leg! I can't stand!" />
	<!-- Erschöpfung / Frustration -->
	<comment key="Medic!" text="Not today. Not for this bullshit." />
	<comment key="Medic!" text="I didn't sign up for this..." />
	<comment key="Medic!" text="Someone! Anyone!" />
	<!-- Kameradschaftlich -->
	<comment key="Medic!" text="Buddy! I need help!" />
	<comment key="Medic!" text="I'm down! Cover me!" />
	<!-- Traurig / Desillusioniert -->
	<comment key="Medic!" text="I don't want to die here..." />
	<comment key="Medic!" text="Tell my family I tried." />
	<comment key="Medic!" text="AAAARGH!" />
	<!-- Kampfentschlossen -->
	<comment key="Medic!" text="Patch me up. I'm going back in." />
	<comment key="Medic!" text="Fix it. I can still fight." />
	<comment key="Medic!" text="Get me back on my feet!" />
	<!-- Politisch/Insider - The Suits, The Island -->
	<comment key="Medic!" text="Dying for the Suits... great." />

	<!-- ========== All quiet here (Idle) ========== -->
	<!-- Desillusionierung -->
	<comment key="All quiet here" text="Fighting the Euros... this is FUBAR." />
	<comment key="All quiet here" text="Just waiting for the paycheck." />
	<comment key="All quiet here" text="Wonder which island the General is on." />
	<comment key="All quiet here" text="SNAFU. Total SNAFU." />
	<comment key="All quiet here" text="I should have stayed in college." />
	<comment key="All quiet here" text="My contract didn't say shit about fighting Europe." />
	<!-- Blue-on-Blue Verwirrung - gegen EU (ERA_STORY.md Phase 2b) -->
	<comment key="All quiet here" text="Weren't we supposed to be allies?" />
	<comment key="All quiet here" text="How do you explain this to the guys back home?" />
	<comment key="All quiet here" text="Yesterday NATO allies. Today targets. FUBAR." />
	<!-- The Suits / Epstein - nie direkt beim Namen -->
	<comment key="All quiet here" text="Bet the Suits are watching this from a yacht." />
	<comment key="All quiet here" text="The Island crowd sends us to die. Classic." />
	<comment key="All quiet here" text="Can't trust anyone anymore. Not even allies." />
	<!-- Neutral / Filler - garantieren Abwechslung -->
	<comment key="All quiet here" text="*yawns*" />
	<comment key="All quiet here" text="*whistles*" />
	<comment key="All quiet here" text="No contact." />
	<comment key="All quiet here" text="All clear." />
	<comment key="All quiet here" text="Just two more weeks..." />

	<!-- ========== I feel good! (Nach Heilung) ========== -->
	<comment key="I feel good!" text="Back in the fight." />
	<comment key="I feel good!" text="Thanks, Doc. I owe you." />
	<comment key="I feel good!" text="Let's get this over with." />
	<comment key="I feel good!" text="Good to go." />
	<comment key="I feel good!" text="Appreciate it, Doc." />

	<!-- ========== Hold on! (Kamerad kommt) ========== -->
	<comment key="Hold on!" text="On my way! Hang tight!" />
	<comment key="Hold on!" text="Moving to assist!" />
	<comment key="Hold on!" text="I got you, buddy!" />
	<comment key="Hold on!" text="Almost there!" />

	<!-- ========== Reloading ========== -->
	<comment key="Reloading" text="Reloading! Cover me!" />
	<comment key="Reloading" text="Mag change!" />
	<comment key="Reloading" text="Cover me!" />
	<comment key="Reloading" text="Give me a second!" />

	<!-- ========== enemy seen ========== -->
	<comment key="enemy seen" text="Contact front!" />
	<comment key="enemy seen" text="Tangos! 12 o'clock!" />
	<comment key="enemy seen" text="Alert!" />
	<comment key="enemy seen" text="Hostiles!" />


	<!-- ========== grenade alert ========== -->
	<comment key="grenade alert, grenade tag = grenade" text="Frag out! Move!" />
	<comment key="grenade alert, grenade tag = grenade" text="Grenade! Get down!" />
	<comment key="grenade alert, grenade tag = grenade" text="Look out!" />
	<comment key="grenade alert, grenade tag = flashbang" text="Flash! Watch your eyes!" />
	<comment key="grenade alert, grenade tag = flashbang" text="Flashbang! Eyes shut!" />
	<comment key="grenade alert, grenade tag = rocket" text="Incoming! RPG!" />
	<comment key="grenade alert, grenade tag = rocket" text="Rocket! Down!" />

	<!-- ========== Yes sir (Affirmative) ========== -->
	<comment key="Yes sir" text="Roger." />
	<comment key="Yes sir" text="Solid copy." />
	<comment key="Yes sir" text="On it." />
	<comment key="Yes sir" text="Moving." />
	<comment key="Yes sir" text="Got it." />

	<!-- ========== celebrating ========== -->
	<!-- Gedämpft - kein Jubel, nur Erleichterung und Zynismus -->
	<comment key="celebrating" text="We made it." />
	<comment key="celebrating" text="Can't believe I'm still alive." />
	<comment key="celebrating" text="That's how it's done. Whatever 'it' even is." />
	<comment key="celebrating" text="Still here. For now." />
	<comment key="celebrating" text="Yeah. Sure. We 'won'." />
	<comment key="celebrating" text="The Suits will take the credit. We take the wounds." />

	<!-- ========== Good job, soldiers ========== -->
	<comment key="Good job, soldiers" text="Good work, men." />
	<comment key="Good job, soldiers" text="Solid work out there." />
	<comment key="Good job, soldiers" text="Well done." />

	<!-- ========== We surrender! ========== -->
	<comment key="We surrender!" text="Don't shoot!" />
	<comment key="We surrender!" text="We're done! Cease fire!" />
	<comment key="We surrender!" text="We surrender!" />
	<comment key="We surrender!" text="Hands up! Don't shoot!" />

</character>
