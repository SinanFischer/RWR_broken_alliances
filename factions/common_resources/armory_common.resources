<?xml version="1.0" encoding="utf-8"?>
<!-- Waffen + Carry-Items für Waffenkammer (alle Fraktionen). Nur Referenzen; in_stock/price in .weapon/.carry_item. -->
<resources>
	<!-- Medical Dart Gun (Vanilla dartgun): für alle Fraktionen kaufbar (Mod-Override in_stock=1, price 120). -->
	<weapon key="dartgun.weapon" />
	<weapon key="truvelo_amris.weapon" />
	<!-- Ultimax 100 (+ M) + Gilboa DBR nur EU: armory_grey -->
	<!-- M1 Garand Modern nur USA: armory_green + green_primaries (Default) -->
	<!-- QBZ + Origin: nur KI (Shotgun/EOD_LIGHT/SF), nicht in Waffenkammer -->
	<!-- Verbundbogen normal: nur KI (Miniboss 5 % Explosiv), nicht in Waffenkammer -->
	<weapon key="compound_bow_alt.weapon" />
	<!-- RPK-16 / RPK-16 Long / AN-94 nur Russia: armory_brown -->
	<!-- M200 (CheyTac) nur USA: armory_green -->
	<!-- GL-AR nur fraktionsweise: armory_green (M16A4 M203), armory_grey (G36 AG36), armory_brown (AK-47 GP25), jeweils rifle-active -->
	<weapon key="qlz87_b.weapon" />
	<weapon key="fhj01.weapon" />
	<!-- Deploy-Varianten (Scoped) für alle Fraktionen -->
