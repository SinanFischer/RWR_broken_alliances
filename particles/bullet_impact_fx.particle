material xBulletCasing{
	receive_shadows off
	technique {
		pass {
			lighting off
			depth_write off
			scene_blend add
			fog_override true

			texture_unit {
				texture bullet_casing.png
			}
		}
	}
}

material xShotCasing{
	receive_shadows off
	technique {
		pass {
			lighting off
			depth_write off
			scene_blend alpha_blend
			fog_override true

			texture_unit {
				texture shot_casing.png
			}
		}
	}
}

particle_system 			xLahtiMuzzle
{
	quota					1000
	material				Flame
	particle_width			4.0
	particle_height			4.0
	cull_each				false
	renderer				billboard
	billboard_type			oriented_self
	accurate_facing 		true

	emitter Point
	{
		colour	1 1 1 1
		width 0
		height 0
		depth 0
		emission_rate 37.5
		velocity_min 1
		velocity_max 1
		time_to_live 0.04
		duration_min 0.025
		duration_max 0.025
	}
	
	affector ColourInterpolator
	{
		colour0	1 1 1 1
		time0	0.1
		colour1	1 1 0 1
		time1	0.3
		colour2	1 0 0 0
		time2	0.7
		colour3	0 0 0 0
		time3	0.8
		colour4	0 0 0 0
		time4	1
		colour5	0.5 0.5 0.5 0
		time5	1
	}
}

particle_system xExpSmoke
{
	material	xExpSmoke
	particle_width 9.0
	particle_height 9.0
	quota 10000
	cull_each	false
	renderer	billboard
	billboard_type	oriented_self
	common_direction	1 1 1
	accurate_facing false

	emitter Point
	{
		colour		1 1 1 0.5
		angle	24
		direction	0 -1 0
		emission_rate	12
		position	0 0 0
		velocity	1.35
		time_to_live	1.5
		duration	0.15
		duration_min	0.15
		duration_max	0.15
	}
 
	affector Scaler
	{
		rate	3
	}

	affector ColourFader
	{
		//red	-0.135
		//green	-0.125
		//blue	-0.09
		alpha -0.33
	}
}

particle_system xExpFog
{
	material	xExpSmoke
	particle_width 9.0
	particle_height 9.0
	quota 10000
	cull_each false
	sorted false
	local_space false
	iteration_interval 0.0
	nonvisible_update_timeout 0.0
	billboard_type point
	billboard_origin center
	billboard_rotation_type vertex
	point_rendering false
	accurate_facing false

	emitter Box
	{
		colour	1 1 1 0.20
		position 0.0 0.0 0.0
		direction 1.0 1.0 1.0
		angle 180
		width 4.0
		height 4.0
		depth 4.0
		emission_rate 38
		velocity_min 0.7
		velocity_max 0.7
		time_to_live 15
		duration_min 0.5
		duration_max 0.5
	}

	affector Scaler
	{
		rate 0.5
	}
	
	affector ColourFader
	{
		alpha	-0.012
	}	
}

