particle_system xFireSmoke
{
	quota	500
	material	xExpSmoke
	particle_width	1.4
	particle_height	1.4
	cull_each	false
	renderer	billboard
	billboard_type	point
	accurate_facing 		false

	emitter Box
	{
		angle	2
		colour	1 1 1 0.125
		direction	0 1 0.2
		emission_rate	25
		position	0 0 0
    		width 0.1
    		height 0.0
   		depth 0.1

		velocity_min	1.0
		velocity_max	2.4

		time_to_live_min	6
		time_to_live_max	10
		duration	0.0
	}

	affector Scaler
	{
		rate	0.75
	}

	affector Rotator
	{
		rotation_speed_range_start	-45
		rotation_speed_range_end	45
		rotation_range_start	0
		rotation_range_end	360
	}

	affector ColourFader
	{
		red	0
		green	0
		blue	0
		alpha	-0.025
	}

	affector LinearForce
	{
		force_vector 0.5 0.5 0
		force_application add
	}

}

material xwoosh
{
    technique
    {
        pass
        {
            lighting off
            scene_blend alpha_blend
            depth_write off

            texture_unit
            {
                texture woosh.png 
                tex_address_mode clamp
            }
        }
    }
}

particle_system xwoosh
{

        quota                                   500
        material                                xwoosh
        particle_width                          2.0
        particle_height                         2.0
        renderer                                billboard 
        billboard_type                          oriented_common
      	common_up_vector                  			0 0 1 

        emitter                                 Point 
        {

		colour	0.9 0.9 0.9 0.3

    position 0 0 0
		direction	0 1 0
		emission_rate	30
		time_to_live	0.3
		duration	0.05
		duration_min	0.05
		duration_max	0.05    


        }
        affector                                Scaler 
        {
            rate                                60.0
        }

	affector ColourFader
	{
		red	-1.0
		green	-1.0
		blue	-1.0
		alpha	-1.0
	}
        
   
}

