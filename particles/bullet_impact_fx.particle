		direction			0 1 0
		emission_rate		150
		position			0 0 0
		velocity			0
		velocity_min		0
		velocity_max		0
		time_to_live		0.04
		time_to_live_min	0.04
		time_to_live_max	0.04
		duration			0.025
		duration_min		0.025
		duration_max		0.025
		width				0
		height				0
		depth				0
	}
}

particle_system xDirtBurst
{
     material        Piece
    particle_width  0.2
    particle_height 0.2
    cull_each       false
    quota           1000
    billboard_type  point
	accurate_facing 		true
    
    emitter Point
    {
            emission_rate                       500
            angle                               45
            time_to_live                        0.25
            velocity                            8.0
            duration                            0.025
    }

    affector LinearForce
    {
        force_vector      0 -50 0
        force_application add
    }

}

particle_system xKickDust
{
	material		xExpRise
	particle_width 		1
	particle_height 	1
	quota 			500
	cull_each		false
	renderer		billboard
	billboard_type		oriented_self
	common_direction	1 1 1
	accurate_facing 		true

	emitter Point
	{
		colour	1 1 1 0.35
		position 0.0 0.0 0.0
		direction 1.0 1.0 1.0
		angle 0
		width 0.1
		height 0.1
		depth 0.1
		emission_rate 37.5
		velocity_min 2.0
		velocity_max 2.0
		time_to_live 0.5
		duration_min 0.05
		duration_max 0.05
	}

	affector Scaler
	{
		rate 1.0
	}
	
	affector ColourFader
	{
		alpha -0.9
	}
	
}

particle_system xMusketSmoke
{
	material	xExpRise
	particle_width 3.2
	particle_height 3.2
	quota 5000
	cull_each	false
	renderer	billboard
	billboard_type	oriented_self
	common_direction	1 1 1
	accurate_facing 		true

	emitter Point
	{
		colour		1 1 1 0.25
		angle	0
		direction	0 -1 0
		emission_rate	4.5
		position	0 0 0
		velocity	1.5
		time_to_live	3
		duration	0.15
		duration_min	0.15
		duration_max	0.15
	}
 
	affector Scaler
	{
		rate	1.6
	}

	affector ColourFader
	{
		alpha -0.5
	}
}

particle_system xMuzzleDust
{
	quota	100
	material	xDust5
	particle_width	0.75
	particle_height	0.75
	cull_each	true
	renderer	billboard
	billboard_type	oriented_self

	emitter Point
	{
		angle		90
		colour		1 1 1 0.15
		direction	0 0 0
		emission_rate	10
		position	0 0 0
		velocity	5
		velocity_min	0.25
		velocity_max	5
		time_to_live	0.5
		time_to_live_min	0.25
		time_to_live_max	0.5
		duration	0.5
		duration_min	0.25
		duration_max	0.5
	}
 
	affector Scaler
	{
		rate	0.4
	}

	affector Rotator
	{
		rotation_speed_range_start	-45
		rotation_speed_range_end	45
		rotation_range_start	0
		rotation_range_end	360
	}

	affector ColourFader
	{
		alpha	-0.1
	}
}

particle_system xRifleFlash
{
	material	xFlame2
	particle_width 0.55
	particle_height 0.55
	quota 2500
	cull_each				false
	renderer				billboard
	billboard_type			oriented_self
	accurate_facing 		true

	emitter Point
	{
		colour	1 1 1 1
		width 0
		height 0
		depth 0
		emission_rate 48
		velocity_min 1
		velocity_max 1
		time_to_live 0.04
		duration_min 0.025
		duration_max 0.025
	}
	
	affector ColourInterpolator
	{
		colour0	1 1 1 1
		time0	0.1
		colour1	1 1 0 1
		time1	0.3
		colour2	1 0 0 0
		time2	0.7
		colour3	0 0 0 0
		time3	0.8
		colour4	0 0 0 0
		time4	1
		colour5	0.5 0.5 0.5 0
		time5	1
	}
}

