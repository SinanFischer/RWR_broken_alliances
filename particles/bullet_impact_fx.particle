particle_system xAtBurstSmall
{
    material        Piece
    particle_width  0.2
    particle_height 0.2
    cull_each       false
    quota           1000
    billboard_type  point
	accurate_facing 		true
    
    // Area emitter
    emitter Point
    {
            emission_rate                       500
            angle                               135
            time_to_live                        2.0
            velocity                            15
            duration                            0.025
    }

    affector LinearForce
    {
        force_vector      0 -50 0
        force_application add
    }

    affector ColourInterpolator
    {
		colour0	1 1 1 1
		time0	0.1
		colour1	1 1 0 1
		time1	0.3
		colour2	1 0 0 0
		time2	0.7
		colour3	0 0 0 0
		time3	0.8
		colour4	0 0 0 0
		time4	1
		colour5	0.5 0.5 0.5 0
		time5	1
    }

}

material xat_rocket {
	receive_shadows off
	technique {
		pass {
			lighting off
			fog_override true

			depth_write off
			scene_blend add

			texture_unit {
				texture orange_cannon.png
			}
		}
	}
}

