//	Bullet Impact - Object - Damage.
particle_system 				xBulletImpactObjectDamage
{
	quota						1000
	material					xBulletImpactDamage
	particle_width				0.75
	particle_height				0.75
	cull_each					false
	renderer					billboard
	billboard_type				point
	accurate_facing 			false

	// Emitter Type.
	emitter 					Point
	{
		colour					1 1 1 0.25
		direction				0 1 0
		velocity				0
		emission_rate			18
		position				0 0 0
		time_to_live			10
		duration				0.5
	}

	// Fade Rate.
	affector					ColourFader
	{
		alpha					-0.025
	}
}

material xBulletImpactDamage{
	receive_shadows off
	technique {
		pass {
			lighting off
			depth_write off
			scene_blend alpha_blend
			fog_override true

			texture_unit {
				texture impact_damage.png
			}
		}
	}
}

//	Bullet Impact - Object - Glow.
particle_system 				xBulletImpactObjectGlow
{
	quota						10000
	material					Piece
	particle_width				0.15
	particle_height				0.15
	cull_each					false
	renderer					billboard
	billboard_type				point
	accurate_facing 			false

	// Emitter Type.
	emitter 					Point
	{
		emission_rate			1
		direction				0 1 0
		velocity				0
		position				0 0 0
		time_to_live			2.0
		duration				0.5
	}
	
	// Colour Changer - Life.
	affector					ColourImage
	{
		image					impact_glow.png
	}
}

//	Muzzle Casing Throw.
particle_system					xMuzzleCasingThrow
{
	quota						100
	material					xBulletCasing
	particle_width				0.2
	particle_height				0.2
	cull_each					false
	renderer					billboard
	billboard_type				point

	// Emitter Type.
	emitter						Point
	{
		colour					1.0 0.75 0 1
		angle					45
		emission_rate			18
		position				0 0 0
		velocity				-7.5
		time_to_live			0.5
		duration				0.05
	}

	// Casing Rotation.
	affector							Rotator
	{
		rotation_speed_range_start		0
		rotation_speed_range_end		2160
		rotation_range_start			0
		rotation_range_end				360
	}

	// Gravity.
    affector					LinearForce
    {
        force_vector			0 -25 0
        force_application		add
    }
}

