// Subset of Infantry Particle Systems (Heavy Infantry): bullet hit FX + shared muzzle FX.
// Original by Josef Mueller {Anzac Joe}, CC BY-NC-ND 4.0 — see Heavy Infantry mod for full file.
// Textures used: impact_damage.png, impact_glow.png, expsmoke.png, exprise.png, cartoonflame2.png (in textures/).

material xBulletImpactDamage{
	receive_shadows off
	technique {
		pass {
			lighting off
			depth_write off
			scene_blend alpha_blend
			fog_override true

			texture_unit {
				texture impact_damage.png
			}
		}
	}
}

material xExpRise {
	receive_shadows off
	technique {
		pass {
			lighting off
			fog_override true

			depth_write off
			depth_check on
			scene_blend alpha_blend

			texture_unit {
				texture exprise.png
				tex_address_mode clamp
			}
		}
	}
}

material xExpSmoke {
	receive_shadows off
	technique {
		pass {
			lighting off
			fog_override true

			depth_write off
			depth_check on
			scene_blend alpha_blend

			texture_unit {
				texture expsmoke.png
				tex_address_mode clamp
			}
		}
	}
}

material xFlame2 {
        receive_shadows off
	technique {
		pass {
			lighting off
			depth_write off
			scene_blend add
			fog_override true

			texture_unit {
				texture cartoonflame2.png
			}
		}
	}
}

material xDust5 {
	receive_shadows off
	technique {
		pass {
			lighting off
			fog_override false

			depth_write off
			scene_blend alpha_blend 

			texture_unit {
				texture expsmoke.png
				tex_address_mode clamp
			}
		}
	}
}

particle_system 				xBulletImpactObjectDamage
{
	quota						1000
	material					xBulletImpactDamage
	particle_width				0.75
	particle_height				0.75
	cull_each					false
	renderer					billboard
	billboard_type				point
	accurate_facing 			false

	emitter 					Point
	{
		colour					1 1 1 0.25
		direction				0 1 0
		velocity				0
		emission_rate			18
		position				0 0 0
		time_to_live			10
		duration				0.5
	}

	affector					ColourFader
	{
		alpha					-0.025
	}
}

particle_system 				xBulletImpactObjectGlow
{
	quota						10000
	material					Piece
	particle_width				0.15
	particle_height				0.15
	cull_each					false
	renderer					billboard
	billboard_type				point
	accurate_facing 			false

	emitter 					Point
	{
		emission_rate			1
		direction				0 1 0
		velocity				0
		position				0 0 0
		time_to_live			2.0
		duration				0.5
	}
	
	affector					ColourImage
	{
		image					impact_glow.png
	}
}

particle_system xMuzzleFog
{
	material	xExpSmoke
	particle_width 1.15
	particle_height 1.15
	quota 4000
	cull_each false
	sorted false
	local_space false
	iteration_interval 0.0
	nonvisible_update_timeout 0.0
	billboard_type point
	billboard_origin center
	billboard_rotation_type vertex
	point_rendering false
	accurate_facing false

	emitter Box
	{
		colour	1 1 1 0.20
		position 0.0 0.0 0.0
		direction 1.0 1.0 1.0
		angle 180
		width 1.0
		height 1.0
		depth 1.0
		emission_rate 0.35
		velocity_min 0.5
		velocity_max 0.5
		time_to_live 10
		duration_min 0.5
		duration_max 0.5
	}

	affector Scaler
	{
		rate 0.5
	}
	
	affector ColourFader
	{
		alpha	-0.018
	}
	
}

particle_system xShieldBurst
{
    material        Piece
    particle_width  0.2
    particle_height 0.2
    cull_each       false
    quota           1000
    billboard_type  point
	accurate_facing 		true
    
    emitter Point
    {
        angle           180
	colour	1 1 1 1
	colour_range_start	1 1 1 1
	colour_range_end	1 1 1 1
        emission_rate   250
        time_to_live    0.25
        velocity_min 8
        velocity_max 8
        
        duration 0.025
    }

    affector LinearForce
    {
        force_vector      0 -25 0
        force_application add
    }

    affector ColourInterpolator
	{
		colour0	1 1 1 1
		time0	0.1
		colour1	1 1 0 1
		time1	0.3
		colour2	1 0 0 0
		time2	0.7
		colour3	0 0 0 0
		time3	0.8
		colour4	0 0 0 0
		time4	1
		colour5	0.5 0.5 0.5 0
		time5	1
    }

}

particle_system xUpDust2
{
	quota	100
	material	xExpSmoke
	particle_width	0.75
	particle_height	0.75
	cull_each	true
	renderer	billboard
	billboard_type	point
	accurate_facing 		true

	emitter Point
	{
		colour	1 1 1 0.35
		angle	0
		direction	0 1 0
		emission_rate	10
		position	0 0 0
		velocity	0.0
		velocity_min	0.0
		velocity_max	0.0
		time_to_live	1.0
		time_to_live_min	1.0
		time_to_live_max	1.0
		duration	0.25
		duration_min	0.25
		duration_max	0.25
	}
 
	affector Scaler
	{
		rate	0.3
	}

affector LinearForce
{
    force_vector 0 0.8 0
    force_application add
}

	affector ColourFader
	{
		alpha -0.9
	}
}

particle_system 			xBulletFlash
{
	quota					1000
	material				xFlame2
	particle_width			0.5
	particle_height			0.5
	cull_each				false
	renderer				billboard
	billboard_type			point
	accurate_facing 		true

	emitter 				Point
	{
		angle				0
