	{
		angle	0
		colour	1 1 1 1
		colour_range_start	1 1 1 1
		colour_range_end	1 1 1 1
		direction	0 1 0
		emission_rate	1

		position	-40 20 0

		emission_rate	1
		velocity	80.0
		time_to_live	3.0
		duration	0.99

		//repeat_delay    1.0
	}

}
