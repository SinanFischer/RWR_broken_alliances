// TODO: clean this up

import ShadowPlantIntegrated from "shadow_plant.material"
import ShadowPlantIntegrated2 from "shadow_plant.material"
import ShadowPlantSimple from "shadow_plant.material"

material ShadowAirstrikeIntegrated : ShadowPlantIntegrated {
	technique Basic {
		shadow_caster_material ShadowAirstrikeIntegrated2
	}
}

material ShadowAirstrikeIntegrated2 : ShadowPlantIntegrated2 {
	technique ShadersShadows {
		pass Basic {	
			texture_unit Basic {
				texture shadow_airstrike.png
			}
		}
	}
}

material ShadowAirstrikeSimple : ShadowPlantSimple {
	technique NoShaders {
		pass Basic {
			texture_unit Basic {
				texture shadow_airstrike.png
        		}
		} 
	}
}

