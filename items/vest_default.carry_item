<?xml version="1.0" encoding="utf-8"?>
<!-- Default-Weste: Fängt keinen Schuss ab. Erster tödlicher Treffer → wounded (Medic nötig), Weste verbraucht. Danach kein Schutz mehr. -->
<carry_items>
	<carry_item key="vest_default.carry_item" name="Default Vest" slot="1" transform_on_consume="vest_default_used" time_to_live_out_in_the_open="120.0">
		<hud_icon filename="hud_vest.png" />
		<capacity value="1" source="rank" source_value="0.0" />
		<inventory encumbrance="2" price="0" />

		<model mesh_filename="vest.xml" />

		<commonness value="1.0" in_stock="1" can_respawn_with="1" />

		<!-- Erster Treffer: death → wound (Weste wird verbraucht), kein Schuss abgefangen -->
		<modifier class="projectile_blast_result" input_character_state="death" output_character_state="wound" />
		<modifier class="projectile_blast_result" input_character_state="wound" output_character_state="wound" consumes_item="0" />
		<modifier class="projectile_blast_result" input_character_state="stun" output_character_state="stun" consumes_item="0" />
		<modifier class="projectile_hit_result" input_character_state="death" output_character_state="wound" />
		<modifier class="projectile_hit_result" input_character_state="wound" output_character_state="wound" consumes_item="0" />
		<modifier class="projectile_hit_result" input_character_state="stun" output_character_state="stun" consumes_item="0" />
		<modifier class="melee_hit_result" input_character_state="death" output_character_state="wound" />
	</carry_item>

	<carry_item key="vest_default_used" name="Default Vest (used)" slot="1" time_to_live_out_in_the_open="120.0">
		<hud_icon filename="hud_vest_hole2.png" />
		<capacity value="1" source="rank" source_value="0.0" />
		<inventory encumbrance="2" price="0" />

		<model mesh_filename="vest.xml" />

		<commonness value="0.0" in_stock="0" can_respawn_with="0" />

		<!-- Kein Schutz mehr: nächster Treffer = Tod -->
		<modifier class="projectile_blast_result" input_character_state="death" output_character_state="death" />
		<modifier class="projectile_blast_result" input_character_state="wound" output_character_state="wound" consumes_item="0" />
		<modifier class="projectile_hit_result" input_character_state="death" output_character_state="death" />
		<modifier class="projectile_hit_result" input_character_state="wound" output_character_state="wound" consumes_item="0" />
		<modifier class="melee_hit_result" input_character_state="death" output_character_state="death" />
	</carry_item>
</carry_items>
