<?xml version="1.0" encoding="utf-8"?>
<!-- Default-Weste: Kein Schutz, erster tödlicher Treffer wird zu Verletzung (Medic nötig).
     Nur 25% der Default-Soldaten spawnen mit dieser Weste (über default_vests.resources + probability 0.25).
     Nach einem Treffer: Weste verbraucht, nächster Treffer = Tod. -->
<carry_items>
    <carry_item key="vest_default.carry_item" name="Leichte Schutzweste" slot="1" time_to_live_out_in_the_open="120.0" player_death_drop_owner_lock_time="45.0">
        <hud_icon filename="hud_vest1.png" />
        <capacity value="0" source="rank" source_value="0.0" />
        <capacity value="1" source="rank" source_value="0.0" />
        <inventory encumbrance="2" price="5" />

        <model mesh_filename="vest1.xml" />

        <commonness value="0.0" in_stock="0" can_respawn_with="0" />

        <!-- Kein Absorption: tödlicher Treffer -> Verletzung (Medic), Weste einmalig verbraucht -->
        <modifier class="projectile_blast_result" input_character_state="death" output_character_state="wound" consumes_item="1" />
        <modifier class="projectile_blast_result" input_character_state="wound" output_character_state="wound" consumes_item="0" />
        <modifier class="projectile_blast_result" input_character_state="stun" output_character_state="stun" consumes_item="0" />
        <modifier class="projectile_hit_result" input_character_state="death" output_character_state="wound" consumes_item="1" />
        <modifier class="projectile_hit_result" input_character_state="wound" output_character_state="wound" consumes_item="0" />
        <modifier class="projectile_hit_result" input_character_state="stun" output_character_state="stun" consumes_item="0" />
    </carry_item>
</carry_items>
